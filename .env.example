# 复制为 .env 后填写。.env 已被 gitignore。

# ---- 模型 ----
ANTHROPIC_API_KEY=
MEDIC_MODEL=claude-sonnet-5
# 便宜档，用于对照组和大批量跑
MEDIC_MODEL_CHEAP=claude-haiku-4-5-20251001

# ---- 被测系统观测面（由 sut/ 拉起后确认端口）----
PROM_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui
SUT_FRONTEND_URL=http://localhost:8080
FLAGD_UI_URL=http://localhost:8080/feature

# ---- 组件 ----
GATEWAY_ADDR=127.0.0.1:7801
AGENT_ADDR=127.0.0.1:7802

# ---- 纪律：容器统一前缀，便于一键清理 ----
MEDIC_CONTAINER_PREFIX=medic-
